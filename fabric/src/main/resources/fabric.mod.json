{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description} ${credits}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "https://github.com/Mods-For-Lupin/Dis-Enchanting-Table/",
    "sources": "https://github.com/Mods-For-Lupin/Dis-Enchanting-Table/"
  },
  "license": "${license}",
  "icon": "${mod_id}.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.cursee.disenchanting_table.DisEnchantingTableFabric"
    ],
    "client": [
      "com.cursee.disenchanting_table.DisEnchantingTableClientFabric"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14",
    "fabric": "*",
    "minecraft": "${fabric_minecraft_version_range}",
    "java": ">=17"
  },
  "suggests": {
    "another-mod": "*"
  }
}
  